{
	"kit": "viennarna",
	"track": "wasi",
	"source": {
		"repo": "https://github.com/ViennaRNA/ViennaRNA",
		"ref": "v2.7.2"
	},
	"build": {
		"dockerfile": "build/wasi/Dockerfile",
		"args": [
			"--host=wasm32-wasi",
			"--disable-openmp",
			"--disable-pthreads",
			"--without-perl",
			"--without-python",
			"--without-swig",
			"--without-gsl",
			"--disable-mpfr",
			"--without-svm",
			"--without-rnaxplorer",
			"--without-forester",
			"--without-kinfold",
			"--disable-naview"
		],
		"exclude": [
			"naview.c"
		]
	}
}
