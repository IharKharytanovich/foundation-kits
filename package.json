{
  "name": "foundation-kits",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Kit factory: author, build, verify, and publish Foundation Kits.",
  "scripts": {
    "test": "vitest run",
    "new-kit": "node tooling/new-kit.mjs",
    "import-kits": "node tooling/import-kit.mjs --all",
    "verify": "vitest run tests/kits.test.mjs",
    "license-gate": "node tooling/license-gate.mjs",
