    "backfill-urls": "node tooling/backfill-urls.mjs",
    "fetch-vendor": "node tooling/fetch-vendor.mjs"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  }
}
